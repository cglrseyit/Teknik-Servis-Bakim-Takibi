PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
NODE_ENV=production

# Frontend URL (e-posta linkleri için) — uygulamanın kendi sunucumuzdaki adresi
CLIENT_URL=https://your-domain.com

# Bakım hatırlatma maillerinin gönderileceği grup adresi
NOTIFICATION_EMAIL=teknik@bellis.com.tr

# ============================================================
# E-POSTA GÖNDERİMİ (SMTP)
# Üç değişkenin (HOST, USER, PASS) hepsi dolu olmalı; biri boşsa
# e-posta tamamen devre dışı kalır.
# Uygulama kendi sunucumuzda çalışır; mail Bellis Exchange SMTP'si
# üzerinden gönderilir. emailService, SMTP_HOST "resend" içermediği
# sürece klasik SMTP (nodemailer) yolunu kullanır — ek ayar gerekmez.
# ============================================================

# --- AKTİF: Bellis Exchange (kendi sunucumuzun SMTP'si) ---
SMTP_HOST=mail.bellis.com.tr
SMTP_PORT=587                       # 587 = STARTTLS · 465 = implicit TLS · 25 = iç ağ relay
SMTP_USER=bakim@bellis.com.tr       # Exchange'de bu uygulama için açılan gönderici posta kutusu
SMTP_PASS=your_smtp_password
SMTP_FROM=Bellis Teknik Servis <bakim@bellis.com.tr>
SMTP_TLS_REJECT_UNAUTHORIZED=false  # Exchange iç ağda self-signed / iç CA sertifikası kullanıyorsa false bırakın

# --- ALTERNATİF: Resend (yalnızca mail tasarımını test ederken) ---
# Exchange'e erişimin olmadığı bir ortamda test için: aşağıdakilerin
# yorumunu kaldırıp yukarıdaki Exchange bloğunu yorum satırına alın.
# SMTP_HOST "resend" içerince emailService otomatik olarak Resend HTTP
# API'sine (port 443) geçer; bu modda SMTP_PORT/SMTP_USER kullanılmaz,
# yalnızca SMTP_PASS (re_ ile başlayan API key) ve SMTP_FROM gerekir.
# Domain doğrulanmadan yalnızca onboarding@resend.dev ile ve sadece
# Resend hesabı sahibinin e-posta adresine gönderim yapılabilir.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key
# SMTP_FROM=Bellis Teknik Servis <onboarding@resend.dev>
