PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
NODE_ENV=development

# Frontend URL (e-posta linkleri için)
CLIENT_URL=https://your-domain.com

# Bakım hatırlatma maillerinin gönderileceği grup adresi
NOTIFICATION_EMAIL=teknik@bellis.com.tr

# ============================================================
# E-POSTA GÖNDERİMİ (SMTP)
# Üç değişkenin (HOST, USER, PASS) hepsi dolu olmalı; biri boşsa
# e-posta tamamen devre dışı kalır. Her iki sağlayıcı da aynı kodu kullanır,
# yalnızca aşağıdaki değerler değişir.
# ============================================================

# --- AKTİF: Resend (geçici — mail tasarımını test/güncelleme için) ---
# Resend panelinden API key alın (re_ ile başlar), SMTP_PASS'e yazın.
# SMTP_FROM, Resend'de DOĞRULANMIŞ bir alan adından olmalı. Domain
# doğrulanmadan yalnızca onboarding@resend.dev ile ve sadece Resend
# hesabının sahibinin e-posta adresine gönderim yapılabilir.
# NOT: SMTP_HOST "resend" içerdiğinde emailService SMTP yerine Resend HTTP
# API'sini (port 443) kullanır — Railway gibi outbound SMTP portlarını
# engelleyen ortamlarda da çalışır. Bu modda SMTP_PORT ve SMTP_USER kullanılmaz
# (yalnızca SMTP_PASS = API key ve SMTP_FROM gerekir), yine de bırakılabilir.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
SMTP_FROM=Bellis Teknik Servis <onboarding@resend.dev>

# --- KENARDA: Bellis Exchange (uygulama kendi sunucumuza taşınınca aktifleştirilecek) ---
# Yukarıdaki Resend bloğunu yorum satırına alıp aşağıdakilerin yorumunu kaldırın.
# SMTP_HOST=mail.bellis.com.tr
# SMTP_PORT=587                       # 587 = STARTTLS · 465 = implicit TLS · 25 = iç ağ relay
# SMTP_USER=bakim@bellis.com.tr       # Exchange'de bu uygulama için açılan gönderici posta kutusu
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Bellis Teknik Servis <bakim@bellis.com.tr>
# SMTP_TLS_REJECT_UNAUTHORIZED=false  # Exchange iç ağda self-signed / iç CA sertifikası kullanıyorsa aç
