PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
NODE_ENV=development

# Frontend URL (e-posta linkleri için)
CLIENT_URL=https://your-domain.com

# Bakım hatırlatma maillerinin gönderileceği grup adresi
NOTIFICATION_EMAIL=teknik@bellis.com.tr

# SMTP — Bellis Exchange sunucusu (boş bırakılırsa e-posta devre dışı)
SMTP_HOST=mail.bellis.com.tr
SMTP_PORT=587
SMTP_USER=bakim@bellis.com.tr
SMTP_PASS=your_smtp_password
SMTP_FROM=Bellis Teknik Servis <bakim@bellis.com.tr>

# Sunucu self-signed sertifika kullanıyorsa (Exchange iç ağda olabilir) false yapın
# SMTP_TLS_REJECT_UNAUTHORIZED=false
