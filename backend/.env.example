PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
NODE_ENV=development

# Frontend URL (e-posta linkleri için)
CLIENT_URL=https://your-domain.com

# Bakım hatırlatma maillerinin gönderileceği grup adresi
NOTIFICATION_EMAIL=teknik@bellis.com.tr

# SMTP — Bellis Exchange sunucusu
# Üç değişkenin (HOST, USER, PASS) hepsi dolu olmalı; biri boşsa e-posta tamamen devre dışı kalır.
SMTP_HOST=mail.bellis.com.tr
# Port: 587 = STARTTLS (önerilen) · 465 = implicit TLS · 25 = iç ağ relay
SMTP_PORT=587
# Exchange'de bu uygulama için açılan gönderici posta kutusu ve şifresi
SMTP_USER=bakim@bellis.com.tr
SMTP_PASS=your_smtp_password
# Gönderen olarak görünecek ad/adres (genelde SMTP_USER ile aynı)
SMTP_FROM=Bellis Teknik Servis <bakim@bellis.com.tr>

# Exchange iç ağda self-signed / iç CA sertifikası kullanıyorsa bu satırı aç:
# SMTP_TLS_REJECT_UNAUTHORIZED=false
